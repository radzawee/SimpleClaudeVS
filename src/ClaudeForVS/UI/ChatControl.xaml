<UserControl x:Class="ClaudeForVS.UI.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClaudeForVS;component/UI/ChatStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───── Header ───── -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Claude.Hairline}" BorderThickness="0,0,0,1" Padding="12,8,8,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="UsagePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                Background="Transparent" Visibility="Collapsed">
                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FiveHourLabel" FontSize="10" Text="5h"
                                       Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                            <Grid Width="54" Height="4" Margin="0,2,0,0">
                                <Border Background="{StaticResource Claude.OverlayHover}" CornerRadius="2" />
                                <Border x:Name="FiveHourBar" Background="{StaticResource Claude.Accent}" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0" />
                            </Grid>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SevenDayLabel" FontSize="10" Text="7d"
                                       Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                            <Grid Width="54" Height="4" Margin="0,2,0,0">
                                <Border Background="{StaticResource Claude.OverlayHover}" CornerRadius="2" />
                                <Border x:Name="SevenDayBar" Background="{StaticResource Claude.Accent}" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="NewChatButton" Style="{StaticResource Claude.IconButton}" Content="&#xE710;"
                            ToolTip="New chat" Click="OnNewChat" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22" Margin="0,0,8,0">
                        <Ellipse Fill="{StaticResource Claude.Accent}" />
                        <Path Data="{StaticResource Claude.Burst}" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Claude" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" FontSize="10" Text="Using your Claude subscription"
                                   Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───── Conversation ───── -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ScrollViewerStyleKey}}">
            <StackPanel x:Name="Messages" Margin="14,12,14,4" />
        </ScrollViewer>

        <!-- Empty state, shown until the first message. -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" Margin="24,0,24,24" MaxWidth="440">
            <Grid Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,14">
                <Ellipse Fill="{StaticResource Claude.AccentSoft}" />
                <Path Data="{StaticResource Claude.Burst}" Stroke="{StaticResource Claude.Accent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="How can I help with your code?" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Opacity="0.75"
                       Text="Claude can read and search files in your solution to answer questions. It won't change anything." />
            <WrapPanel x:Name="Suggestions" />
        </StackPanel>

        <!-- ───── Composer ───── -->
        <Border Grid.Row="2" Margin="12,6,12,12" CornerRadius="10" Padding="12,10,8,8"
                Background="{StaticResource Claude.Overlay}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Claude.Hairline}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Claude.Accent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Attached selection ("Ask about selection") -->
                <Border x:Name="AttachmentChip" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8"
                        Background="{StaticResource Claude.AccentSoft}" CornerRadius="6" Padding="8,3,3,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Claude.IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="AttachmentText" FontSize="11" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Claude.IconButton}" Content="&#xE711;" FontSize="9" Padding="4" Margin="4,0,0,0"
                                ToolTip="Remove" Click="OnRemoveAttachment" />
                    </StackPanel>
                </Border>

                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Ask Claude about your code…" IsHitTestVisible="False"
                               Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    <TextBox x:Name="Input" Style="{StaticResource Claude.BareTextBox}" AcceptsReturn="True"
                             MinHeight="36" MaxHeight="200" TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown" />
                </Grid>

                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Claude.AccentButton}"
                            Content="&#xE724;" ToolTip="Send (Enter)" Click="OnSendClicked" IsEnabled="False" />
                    <ToggleButton x:Name="IncludeFileToggle" Style="{StaticResource Claude.ToggleChip}" VerticalAlignment="Center"
                                  ToolTip="Send the active editor file (or selection) with your message">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Claude.IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Active file" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,8,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
